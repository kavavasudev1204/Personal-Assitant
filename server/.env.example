# Server Port (Render sets process.env.PORT automatically)
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE_NAME?retryWrites=true&w=majority

# Optional: In-memory MongoDB Fallback for local offline testing (Default: false)
USE_MEMORY_DB=false

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Allowed Client Origin for CORS (Comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,https://YOUR-VERCEL-DOMAIN.vercel.app

