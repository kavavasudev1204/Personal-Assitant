# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas URI for Render deployment)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sales_assistant_db?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Client Origin for CORS (Vercel Frontend URL)
CLIENT_URL=https://your-app-name.vercel.app

# Environment
NODE_ENV=production
